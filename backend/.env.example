# App
APP_NAME=BudgetBox API
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://budget_user:strongpassword@localhost:5432/budget_box

# Logging
LOG_LEVEL=INFO
